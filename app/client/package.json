{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "bun run scripts/sync-shared-schemas.ts",
    "dev": "next dev --port ${CLIENT_PORT:-3000}",
    "build": "next build",
    "build:static": "next build && next export",
    "start": "next start --port ${CLIENT_PORT:-3000}",
    "test": "bun test --dom --preload ./src/test-setup.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "check": "bun run typecheck && biome check src ../packages/shared-schemas",
    "fix": "biome check src ../packages/shared-schemas --write",
    "typecheck": "tsc --noEmit",
    "generate:types": "bunx openapi-typescript ../../docs/api/openapi.yaml -o src/types/api/generated.ts"
  },
  "dependencies": {
    "@hoxt-backlog/shared-schemas": "file:../packages/shared-schemas",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.1",
    "next": "16.2.9",
    "openapi-fetch": "^0.15.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^9.1.0",
    "react-redux": "^9.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": ">=2.0.3",
    "postcss": ">=8.5.10"
  }
}
