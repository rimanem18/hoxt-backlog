{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/entrypoints/bun.serve.ts",
    "start": "bun run src/entrypoints/bun.serve.ts",
    "start:node": "node --import tsx src/entrypoints/node.serve.ts",
    "build:lambda": "bun esbuild --bundle --minify --format=cjs --outfile=./dist/index.js --platform=node --target=node22 ./src/entrypoints/lambda.ts",
    "test": "bun test",
    "test:local": "bun test",
    "check": "bun run typecheck && biome check src ../packages/shared-schemas",
    "fix": "biome check src ../packages/shared-schemas --write",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "cpd": "jscpd -c .jscpd.json src ../packages/shared-schemas",
    "db:generate:test": "BASE_SCHEMA=app_test drizzle-kit generate",
    "db:generate:preview": "BASE_SCHEMA=app_${PROJECT_NAME}_preview drizzle-kit generate",
    "db:generate:production": "BASE_SCHEMA=app_${PROJECT_NAME} drizzle-kit generate",
    "db:generate": "bun run db:generate:test && bun run db:generate:preview && bun run db:generate:production",
    "db:migrate:preview": "BASE_SCHEMA=app_${PROJECT_NAME}_preview drizzle-kit migrate",
    "db:migrate:preview:debug": "BASE_SCHEMA=app_${PROJECT_NAME}_preview bun scripts/migrate-debug.ts",
    "db:migrate:production": "BASE_SCHEMA=app_${PROJECT_NAME} drizzle-kit migrate",
    "db:migrate:test": "BASE_SCHEMA=app_test drizzle-kit migrate",
    "db:migrate": "bun run db:migrate:test && bun run db:migrate:preview && bun run db:migrate:production",
    "db:setup": "bun scripts/setup-rls.ts && bun scripts/setup-triggers.ts",
    "generate:schemas": "bun run scripts/generate-schemas.ts",
    "generate:openapi": "bun run scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1111.0",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-openapi": "^1.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "js-yaml": "^4.3.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "swagger-ui-dist": "^5.32.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "jscpd": "^5.0.14",
    "knip": "^6.32.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "esbuild": "^0.25.12"
  }
}
