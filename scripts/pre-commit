#!/usr/bin/env bash
# Abort on error, unset, or pipefail
set -euo pipefail

# ---- config ----
MIN_SECRET_LEN=4
ENV_BASENAME=".env"
LC_ALL=C
export LC_ALL

# 値スキャン対象から除外する env key
# 「この key の値は secret ではない」と明確に言えるものだけ入れる
ALLOWLIST_KEYS=(
  "ENVIRONMENT"
  "ACCESS_ALLOW_ORIGIN"
  "ACCESS_ALLOW_METHODS"
  "ACCESS_ALLOW_HEADERS"
  "CLIENT_PORT"
  "SERVER_PORT"
  "DB_NAME"
  "DB_USER"
  "DB_PORT"
  "SUPABASE_URL"
  "PROJECT_NAME"
  "CLOUDFLARE_PROJECT_NAME"
  "AWS_REGION"
  "VIEWER_ACCESS_BASE_URL"
  "ENABLE_TEST_ENDPOINTS"
)

# prefix 単位で除外したい場合だけ使う
# VITE_ / NEXT_PUBLIC_ などは「公開される値」だが、
# API_KEY を含む場合もあるため、必要になるまで空のままを推奨
ALLOWLIST_KEY_PREFIXES=(
  # "VITE_"
  # "NEXT_PUBLIC_"
  # "PUBLIC_"
  # "NUXT_PUBLIC_"
)

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

env_file="$repo_root/$ENV_BASENAME"

# staged ファイル一覧（追加/コピー/修正のみ）
staged_files_tmp="$(mktemp)"
patterns_tmp="$(mktemp)"
content_tmp="$(mktemp)"
env_entries_tmp="$(mktemp)"
to_clean=("$staged_files_tmp" "$patterns_tmp" "$content_tmp" "$env_entries_tmp")
cleanup() { rm -f "${to_clean[@]}" 2>/dev/null || true; }
trap cleanup EXIT

is_allowlisted_key() {
  local key="$1"
  local allow
  local prefix

  for allow in "${ALLOWLIST_KEYS[@]}"; do
    if [ "$key" = "$allow" ]; then
      return 0
    fi
  done

  for prefix in "${ALLOWLIST_KEY_PREFIXES[@]}"; do
    case "$key" in
      "$prefix"*) return 0 ;;
    esac
  done

  return 1
}

looks_like_secret_key() {
  local key="$1"
  local upper_key

  upper_key="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"

  case "$upper_key" in
    *SECRET*|*TOKEN*|*PASSWORD*|*PASS*|*PRIVATE*|*API_KEY*|*ACCESS_KEY*|*CLIENT_SECRET*|DATABASE_URL|REDIS_URL|JWT_SECRET|SESSION_SECRET)
      return 0
      ;;
  esac

  return 1
}

should_scan_env_value() {
  local key="$1"
  local val="$2"

  # 明示 allowlist された key は検査しない
  if is_allowlisted_key "$key"; then
    return 1
  fi

  # secret っぽい key は値の長さに関係なく検査する
  if looks_like_secret_key "$key"; then
    [ -n "$val" ] && return 0
    return 1
  fi

  # secret っぽくない key は短すぎる値を除外
  if [ -n "$val" ] && [ "${#val}" -ge "$MIN_SECRET_LEN" ]; then
    return 0
  fi

  return 1
}

git diff --cached --name-only --diff-filter=ACM >"$staged_files_tmp"

# 何もステージされていなければ終了
if ! [ -s "$staged_files_tmp" ]; then
  exit 0
fi

# テンプレートとして正当にコミットしてよいファイル（実値を含まない前提）
ENV_TEMPLATE_ALLOWLIST=(
  "$ENV_BASENAME.example"
  "$ENV_BASENAME.sample"
)

is_allowlisted_env_template() {
  local f="$1"
  local allow

  for allow in "${ENV_TEMPLATE_ALLOWLIST[@]}"; do
    if [ "$f" = "$allow" ]; then
      return 0
    fi
  done

  return 1
}

# .env/.env.* が直接ステージされていれば即ブロック（テンプレートファイルは除く）
while IFS= read -r f; do
  if is_allowlisted_env_template "$f"; then
    continue
  fi

  case "$f" in
    "$ENV_BASENAME"|"$ENV_BASENAME".*)
      printf '%s\n' "ERROR: '$f' をコミットしようとしています。中止します。"
      printf '%s\n' "-> $ENV_BASENAME 系はリポジトリに含めないでください（.gitignore 推奨）"
      exit 1
      ;;
  esac
done < "$staged_files_tmp"

# .env が無ければ中身スキャンはしない
if ! [ -f "$env_file" ]; then
  exit 0
fi

: > "$patterns_tmp"
: > "$env_entries_tmp"

while IFS= read -r raw || [ -n "${raw-}" ]; do
  # 前後空白を削る
  line="${raw#"${raw%%[! 	]*}"}"
  line="${line%"${line##*[! 	]}"}"

  # 空行/コメント
  [ -z "$line" ] && continue
  case "$line" in \#*) continue ;; esac

  # 先頭 export を許容
  case "$line" in
    export\ *) line="${line#export }" ;;
  esac

  # KEY=VALUE 形式のみ対象
  case "$line" in
    *=*)
      key="${line%%=*}"
      val="${line#*=}"

      # key の前後空白除去
      key="${key#"${key%%[! 	]*}"}"
      key="${key%"${key##*[! 	]}"}"

      # 値の前後空白除去
      val="${val#"${val%%[! 	]*}"}"
      val="${val%"${val##*[! 	]}"}"

      # 値が "..." または '...' で囲まれていれば剥がす
      if [ "${#val}" -ge 2 ]; then
        first="${val%${val#?}}"
        last="${val##*${val%?}}"

        if [ "$first" = '"' ] && [ "$last" = '"' ]; then
          val="${val:1:${#val}-2}"
        elif [ "$first" = "'" ] && [ "$last" = "'" ]; then
          val="${val:1:${#val}-2}"
        fi
      fi

      if should_scan_env_value "$key" "$val"; then
        # grep -F のパターンファイルに 1 行 1 値で追記
        printf '%s\n' "$val" >>"$patterns_tmp"

        # 後で「どの KEY が当たったか」を表示するために保持
        # 実値は最終出力しない
        printf '%s\t%s\n' "$key" "$val" >>"$env_entries_tmp"
      fi
      ;;
  esac
done < "$env_file"

# パターンが無ければ終了
if ! [ -s "$patterns_tmp" ]; then
  exit 0
fi

violations=0

# 各ステージ済みファイルの「インデックス内容」をチェック（作業ツリーではない）
while IFS= read -r file; do
  # バイナリ（staged blob）ならスキップ
  if ! git show ":$file" | grep -Iq . ; then
    continue
  fi

  # 内容を一時ファイルへ
  git show ":$file" >"$content_tmp"

  if grep -F -f "$patterns_tmp" -n -H "$content_tmp" >/dev/null 2>&1; then
    printf '%s\n' "ERROR: $ENV_BASENAME の値に一致する文字列がステージ済みファイルに含まれています。コミットを中止します。"
    printf '%s\n' "対象ファイル: $file"

    # どの KEY が当たったか。秘密の実値は表示しない。
    while IFS="$(printf '\t')" read -r key val || [ -n "${key-}" ]; do
      [ -z "${key-}" ] && continue
      [ -z "${val-}" ] && continue

      if grep -F -q -- "$val" "$content_tmp"; then
        printf '  - %s の値が検出されました\n' "$key"
      fi
    done < "$env_entries_tmp"

    printf '\n対処案:\n'
    printf '  1) 秘密値を除去し、再度ステージ（git add）してください。\n'
    printf '  2) 秘密はコードに埋め込まず、環境変数/Secret Manager 等を利用してください。\n'
    violations=1
  fi
done < "$staged_files_tmp"

if [ "$violations" -ne 0 ]; then
  exit 1
fi

exit 0
